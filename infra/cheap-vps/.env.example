# Dominio o subdominio apuntando al VPS. Ejemplo: realtime.example.com
REALTIME_DOMAIN=realtime.example.com

# Origenes permitidos para abrir WebSocket. Separar con espacios si hay varios.
# Ejemplo produccion: https://example.com https://www.example.com
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://example.com

# Generar con: openssl rand -base64 48
# Debe ser igual al secreto usado por tu backend Node para firmar JWT.
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=change_me_generate_a_long_random_secret

# Generar con: openssl rand -base64 32
# Solo el backend debe conocer esta clave para publicar en Centrifugo.
CENTRIFUGO_HTTP_API_KEY=change_me_generate_a_long_random_api_key
